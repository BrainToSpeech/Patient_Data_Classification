{
  "input_file": "X_eeg.npy",
  "sfreq": 500,
  "epochs": 500,
  "batch_size": 16,
  "lr": 1e-5,
  "weight_decay": 0.0001,
  "patience": 100,
  "seed": 42,
  "val_test_ratio": 0.2,
  "weighted_sampler": true,
  "window_size": 256,
  "window_stride": 128,
  "run_window_diagnostic": false,
  "balance_rest_to_target": false,
  "run_5fold_cross_validation": true,
  "selection_metric": "balanced_loss"
}
